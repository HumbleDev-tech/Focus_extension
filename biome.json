{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.js",
      "src/**/*.js",
      "*.json",
      "*.css",
      "*.html",
      "_locales/**/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "useOptionalChain": "info",
        "useArrowFunction": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "style": {
        "useTemplate": "off"
      }
    }
  },
  "javascript": {
    "globals": [
      "chrome",
      "window",
      "document",
      "navigator",
      "location",
      "globalThis",
      "sessionStorage",
      "localStorage",
      "MutationObserver",
      "IntersectionObserver",
      "CustomEvent",
      "Event",
      "setTimeout",
      "clearTimeout",
      "setInterval",
      "clearInterval",
      "requestAnimationFrame",
      "cancelAnimationFrame",
      "fetch",
      "atob",
      "btoa",
      "URL",
      "URLSearchParams",
      "AbortController",
      "Node",
      "Element",
      "matchMedia",
      "console",
      "importScripts",
      "DEFAULT_SETTINGS",
      "PRESET_MAP",
      "TOGGLE_KEYS",
      "ALL_TOGGLE_KEYS",
      "POWER_MODULE_KEYS",
      "POWER_MODULE_DEFAULTS",
      "POWER_MODULE_OFF",
      "DEFAULT_PROFILES",
      "MAX_PROFILES",
      "extractToggles",
      "getTranslation"
    ],
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
