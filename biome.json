{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["*.js", "*.json", "*.css", "*.html", "_locales/**/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "useOptionalChain": "info",
        "useArrowFunction": "off"
      },
      "style": {
        "useTemplate": "off"
      }
    }
  },
  "javascript": {
    "globals": [
      "chrome",
      "window",
      "document",
      "navigator",
      "MutationObserver",
      "fetch"
    ],
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
